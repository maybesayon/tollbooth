# Optional break-glass admin credential for the API, also used once in the dashboard to create
# the first admin account (or use `tollbooth create-user`). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TOLLBOOTH_ADMIN_TOKEN=

# Required. Fernet key(s) used to encrypt provider API keys at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate, put the new key first: TOLLBOOTH_ENCRYPTION_KEY=new_key,old_key
TOLLBOOTH_ENCRYPTION_KEY=

TOLLBOOTH_DATABASE_URL=sqlite+aiosqlite:///./data/tollbooth.db
# Postgres: postgresql+asyncpg://user:password@host:5432/tollbooth
# With docker-compose.postgres.yml, set this instead (the URL is built for you):
# POSTGRES_PASSWORD=
TOLLBOOTH_AUTO_MIGRATE=true
TOLLBOOTH_PRICING_FILE=pricing.toml

TOLLBOOTH_OPENAI_BASE_URL=https://api.openai.com
TOLLBOOTH_ANTHROPIC_BASE_URL=https://api.anthropic.com
TOLLBOOTH_UPSTREAM_CONNECT_TIMEOUT=10
TOLLBOOTH_UPSTREAM_READ_TIMEOUT=600
TOLLBOOTH_LOG_LEVEL=INFO

# Directory containing the built dashboard (dashboard/dist). The Docker image sets this.
# TOLLBOOTH_DASHBOARD_DIR=../dashboard/dist

# Dashboard sessions. Set TOLLBOOTH_COOKIE_SECURE=true when serving over HTTPS through a proxy.
# TOLLBOOTH_SESSION_TTL_HOURS=168
# TOLLBOOTH_COOKIE_SECURE=true

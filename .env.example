# Required. Bearer token for the /admin API. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TOLLBOOTH_ADMIN_TOKEN=

# Required. Fernet key(s) used to encrypt provider API keys at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# To rotate, put the new key first: TOLLBOOTH_ENCRYPTION_KEY=new_key,old_key
TOLLBOOTH_ENCRYPTION_KEY=

TOLLBOOTH_DATABASE_URL=sqlite+aiosqlite:///./data/tollbooth.db
TOLLBOOTH_AUTO_MIGRATE=true
TOLLBOOTH_PRICING_FILE=pricing.toml

TOLLBOOTH_OPENAI_BASE_URL=https://api.openai.com
TOLLBOOTH_ANTHROPIC_BASE_URL=https://api.anthropic.com
TOLLBOOTH_UPSTREAM_CONNECT_TIMEOUT=10
TOLLBOOTH_UPSTREAM_READ_TIMEOUT=600
TOLLBOOTH_LOG_LEVEL=INFO
